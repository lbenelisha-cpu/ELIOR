//@version=6
indicator("LEVI · Direction + POC + Position Barriers", overlay=true, max_lines_count=100, max_labels_count=40, max_boxes_count=160, max_bars_back=500)
// Visual aid only. Broker data, sessions and candle boundaries can differ.
// Display-only simple moving averages use the selected chart symbol and timeframe.
bool showMa20 = input.bool(true, "SMA 20", group="Moving averages")
bool showMa50 = input.bool(true, "SMA 50", group="Moving averages")
bool showMa100 = input.bool(true, "SMA 100", group="Moving averages")
bool showMa200 = input.bool(true, "SMA 200", group="Moving averages")
float ma20 = ta.sma(close, 20)
float ma50 = ta.sma(close, 50)
float ma100 = ta.sma(close, 100)
float ma200 = ta.sma(close, 200)
plot(showMa20 ? ma20 : na, "SMA 20", color=#ffc857, linewidth=2)
plot(showMa50 ? ma50 : na, "SMA 50", color=#48d597, linewidth=2)
plot(showMa100 ? ma100 : na, "SMA 100", color=#ed86d1, linewidth=2)
plot(showMa200 ? ma200 : na, "SMA 200", color=#397dff, linewidth=2)

int n = input.int(50, "Closed bars", minval=20, maxval=200)
float deviations = input.float(2.0, "Regression deviations", minval=0.5, maxval=3)
bool showRegression = input.bool(true, "Show regression (display only)")
bool showPoc = input.bool(true, "Show fixed range volume profile / POC")
bool confirmedOnly = input.bool(true, "Require two touches on each swing boundary")
var array<line> drawings = array.new<line>()
var array<label> captions = array.new<label>()

// Same strict 2-left/2-right pivots and candidate selection as the app.
swingCandidate(array<float> lows, array<float> highs, array<float> closes, bool lowSide, int count) =>
    array<int> anchors = array.new<int>()
    array<int> opposite = array.new<int>()
    for i = 2 to count - 3
        bool pl = true
        bool ph = true
        for j = -2 to 2
            if j != 0
                pl := pl and array.get(lows, i) < array.get(lows, i+j)
                ph := ph and array.get(highs, i) > array.get(highs, i+j)
        if lowSide ? pl : ph
            array.push(anchors, i)
        if lowSide ? ph : pl
            array.push(opposite, i)
    float slope = na
    float lower = na
    float upper = na
    int a = na
    int b = na
    int lc = 0
    int hc = 0
    bool valid = false
    if array.size(anchors) >= 2 and array.size(opposite) > 0
        b := array.last(anchors)
        for k = 0 to array.size(anchors)-2
            int candidate = array.get(anchors, k)
            if b-candidate >= 3
                a := candidate
        if not na(a)
            array<float> values = lowSide ? lows : highs
            slope := (array.get(values,b)-array.get(values,a))/(b-a)
            float edge = array.get(values,a)-slope*a
            float other = na
            for k = 0 to array.size(opposite)-1
                int i = array.get(opposite,k)
                if i >= a
                    float value = array.get(lowSide ? highs : lows,i)-slope*i
                    other := na(other) ? value : lowSide ? math.max(other,value) : math.min(other,value)
            lower := lowSide ? edge : other
            upper := lowSide ? other : edge
            float tolerance = math.max((upper-lower)*0.025,array.last(closes)*0.0001)
            valid := not na(other) and upper > lower
            for i = a to count-1
                float closeValue = array.get(closes,i)
                if closeValue < lower+slope*i-tolerance or closeValue > upper+slope*i+tolerance
                    valid := false
            for k = 0 to array.size(anchors)-1
                int i = array.get(anchors,k)
                if i >= a and math.abs(array.get(values,i)-(edge+slope*i)) <= tolerance
                    if lowSide
                        lc += 1
                    else
                        hc += 1
            for k = 0 to array.size(opposite)-1
                int i = array.get(opposite,k)
                if i >= a and math.abs(array.get(lowSide ? highs : lows,i)-(other+slope*i)) <= tolerance
                    if lowSide
                        hc += 1
                    else
                        lc += 1
    [valid, slope, lower, upper, a, b, lc, hc]

// Range must contain the first channel anchor; it cannot be moved to the exit.
initialZone(array<float> lows, array<float> highs, array<float> closes, int first, float slope, float lower, float upper, int count, int timeOffset) =>
    int zone = 0
    int rangeStart = na
    int rangeEnd = na
    float rangeLow = na
    float rangeHigh = na
    if not na(first) and upper > lower
        for length = 8 to 3
            if zone == 0
                for start = math.max(0,first-length+1) to first
                    if zone == 0 and start+length <= count
                        float lo = array.get(lows,start)
                        float hi = array.get(highs,start)
                        float location = 0
                        bool inside = true
                        for i = start to start+length-1
                            lo := math.min(lo,array.get(lows,i))
                            hi := math.max(hi,array.get(highs,i))
                            float q = ((array.get(highs,i)+array.get(lows,i))/2-lower-slope*i)/(upper-lower)
                            inside := inside and q >= 0 and q <= 1
                            if i > start
                                inside := inside and time[timeOffset+count-1-i]-time[timeOffset+count-i] == 300000
                            location += q/length
                        float drift = hi > lo ? math.abs(array.get(closes,start+length-1)-array.get(closes,start))/(hi-lo) : 1
                        if inside and hi > lo and (hi-lo)/(upper-lower) <= 0.35 and drift <= 0.5
                            zone := location <= 1.0/3 ? 1 : location >= 2.0/3 ? 3 : 2
                            rangeStart := start
                            rangeEnd := start+length-1
                            rangeLow := lo
                            rangeHigh := hi
    [zone,rangeStart,rangeEnd,rangeLow,rangeHigh]

var int savedZone = 0
var int savedRangeStart = na
var int savedRangeEnd = na
var float savedRangeLow = na
var float savedRangeHigh = na
var int vpA = na
var int vpB = na
var int vpReturnedAt = na
var int processedBar = na
var int vpSide = 0
var int vpZone = 0
var float vpLow = na
var float vpHigh = na
var float vpPriceA = na
var float vpPriceB = na
var float vpPoc = na
var float vpSlope = na
var float vpLower = na
var float vpUpper = na
var int vpFirst = na
var int vpChannelStart = na
var array<float> vpVolumes = array.new<float>(128,0)
var array<float> vpPriceMass = array.new<float>(128,0)
var array<box> vpBoxes = array.new<box>()
var array<line> vpLines = array.new<line>()
var array<label> vpLabels = array.new<label>()
var table pocTable = table.new(position.top_right,1,6,bgcolor=color.new(color.black,15))

// Rebuild the last valid geometry on reload from a bounded 200-bar history.
// Only closed candles update the snapshot; no bot entry state is inferred.
var float savedSlope = na
var float savedLower = na
var float savedUpper = na
var int savedFirst = na
var int savedStart = na
var int savedLast = na
var int savedLowTouches = 0
var int savedHighTouches = 0
var int brokenAt = na
var string brokenDirection = ""

if bar_index >= n and bar_index >= last_bar_index - 200
    for item in drawings
        line.delete(item)
    array.clear(drawings)
    for item in captions
        label.delete(item)
    array.clear(captions)
    int offset = barstate.isconfirmed ? 0 : 1
    int first = bar_index-offset-n+1
    int last = bar_index-offset
    array<float> lows = array.new<float>()
    array<float> highs = array.new<float>()
    array<float> closes = array.new<float>()
    float sumY = 0
    float sumXY = 0
    for i = 0 to n-1
        int back = offset+n-1-i
        float value = close[back]
        array.push(lows,low[back])
        array.push(highs,high[back])
        array.push(closes,value)
        sumY += value
        sumXY += i*value
    float sumX = n*(n-1)/2.0
    float sumXX = n*(n-1)*(2*n-1)/6.0
    float slope = (n*sumXY-sumX*sumY)/(n*sumXX-sumX*sumX)
    float intercept = (sumY-slope*sumX)/n
    float squaredError = 0
    for i = 0 to n-1
        squaredError += math.pow(array.get(closes,i)-intercept-slope*i,2)
    float width = deviations*math.sqrt(squaredError/n)
    if barstate.islast and showRegression
        for band = -1 to 1
            array.push(drawings,line.new(first,intercept+band*width,last,intercept+slope*(n-1)+band*width,color=color.aqua,width=band==0 ? 1 : 2))
        array.push(captions,label.new(last,intercept+slope*(n-1)+width,"Regression · closed bars",style=label.style_label_left,color=color.new(color.blue,65),textcolor=color.white))
    [v1,s1,l1,u1,a1,b1,lc1,hc1] = swingCandidate(lows,highs,closes,true,n)
    [v2,s2,l2,u2,a2,b2,lc2,hc2] = swingCandidate(lows,highs,closes,false,n)
    bool geometryFound = v1 or v2
    v1 := v1 and (not confirmedOnly or (lc1>=2 and hc1>=2))
    v2 := v2 and (not confirmedOnly or (lc2>=2 and hc2>=2))
    bool provisional1 = lc1<2 or hc1<2
    bool provisional2 = lc2<2 or hc2<2
    bool choose1 = v1 and (not v2 or b1>b2 or (b1==b2 and ((not provisional1 and provisional2) or (provisional1==provisional2 and u1-l1<=u2-l2))))
    // RECENT_WAVE_POC_V2: closed candles only; A is the latest pullback,
    // B follows that wave's extreme until its first completed POC return.
    bool recalcProfile = false
    if na(processedBar) or last > processedBar
        processedBar := last
        if not na(vpA) and last-vpA >= 490
            vpA := na
            vpB := na
            vpPoc := na
            vpReturnedAt := na
        if not na(vpB) and na(vpReturnedAt)
            bool better = vpSide == 1 ? high[offset] > vpPriceB : low[offset] < vpPriceB
            if better
                vpB := last
                vpPriceB := vpSide == 1 ? high[offset] : low[offset]
                recalcProfile := true
            else if last > vpB and not na(vpPoc) and (vpSide == 1 ? close[offset+1] > vpPoc and low[offset] <= vpPoc : close[offset+1] < vpPoc and high[offset] >= vpPoc)
                vpReturnedAt := last
        if not na(savedLast) and last > savedLast and last-savedFirst < 490 and savedLowTouches >= 2 and savedHighTouches >= 2
            float topNow = savedUpper+savedSlope*(last-savedFirst)
            float lowNow = savedLower+savedSlope*(last-savedFirst)
            bool brokeUp = close[offset+1] <= topNow-savedSlope and high[offset] > topNow
            bool brokeDown = close[offset+1] >= lowNow-savedSlope and low[offset] < lowNow
            if brokeUp and brokeDown
                vpA := na
                vpB := na
                vpPoc := na
                vpReturnedAt := na
                savedLast := na
                recalcProfile := false
            else if brokeUp or brokeDown
                int direction = brokeUp ? 1 : -1
                bool newWave = na(vpB) or direction != vpSide or not na(vpReturnedAt)
                int begin = na(vpB) ? savedStart : math.max(savedFirst,direction == vpSide ? vpReturnedAt : vpB)
                if newWave and not na(begin) and begin < last
                    vpSide := direction
                    vpA := begin
                    for i = begin to last-1
                        int back = bar_index-i
                        int anchorBack = bar_index-vpA
                        if vpSide == 1 ? low[back] <= low[anchorBack] : high[back] >= high[anchorBack]
                            vpA := i
                    vpPriceA := vpSide == 1 ? low[bar_index-vpA] : high[bar_index-vpA]
                    vpPriceB := vpSide == 1 ? high[offset] : low[offset]
                    vpB := last
                    vpReturnedAt := na
                    vpZone := savedZone
                    vpSlope := savedSlope
                    vpLower := savedLower
                    vpUpper := savedUpper
                    vpFirst := savedFirst
                    vpChannelStart := savedStart
                    recalcProfile := true
    if recalcProfile and not na(vpA)
        vpLow := low[bar_index-vpA]
        vpHigh := high[bar_index-vpA]
        for i = vpA to vpB
            int back = bar_index-i
            vpLow := math.min(vpLow,low[back])
            vpHigh := math.max(vpHigh,high[back])
        array.fill(vpVolumes,0)
        array.fill(vpPriceMass,0)
        float step = (vpHigh-vpLow)/128
        bool volumeValid = step > 0
        if step > 0
            for i = vpA to vpB
                int back = bar_index-i
                volumeValid := volumeValid and not na(volume[back]) and volume[back] >= 0
                if high[back] > low[back]
                    for bin = 0 to 127
                        float segmentLow = math.max(vpLow+bin*step,low[back])
                        float segmentHigh = math.min(vpLow+(bin+1)*step,high[back])
                        float overlap = math.max(0,segmentHigh-segmentLow)
                        float allocated = nz(volume[back])*overlap/(high[back]-low[back])
                        array.set(vpVolumes,bin,array.get(vpVolumes,bin)+allocated)
                        array.set(vpPriceMass,bin,array.get(vpPriceMass,bin)+allocated*(segmentLow+segmentHigh)/2)
                else
                    int bin = math.max(0,math.min(127,int(math.floor((low[back]-vpLow)/step))))
                    array.set(vpVolumes,bin,array.get(vpVolumes,bin)+nz(volume[back]))
                    array.set(vpPriceMass,bin,array.get(vpPriceMass,bin)+nz(volume[back])*low[back])
        float largest = array.max(vpVolumes)
        int pocIndex = array.indexof(vpVolumes,largest)
        float pocBinVolume = pocIndex>=0 ? array.get(vpVolumes,pocIndex) : 0
        vpPoc := volumeValid and largest > 0 and pocBinVolume>0 ? array.get(vpPriceMass,pocIndex)/pocBinVolume : na
    if not na(savedLast) and last > savedLast and na(brokenAt)
        float tolerance = math.max((savedUpper-savedLower)*0.025,close[offset]*0.0001)
        float projectedLower = savedLower+savedSlope*(last-savedFirst)
        float projectedUpper = savedUpper+savedSlope*(last-savedFirst)
        if close[offset] < projectedLower-tolerance or close[offset] > projectedUpper+tolerance
            brokenAt := last
            brokenDirection := close[offset] < projectedLower-tolerance ? "נשברה מטה" : "נפרצה מעלה"
    if v1 or v2
        savedSlope := choose1 ? s1 : s2
        savedLower := choose1 ? l1 : l2
        savedUpper := choose1 ? u1 : u2
        savedFirst := first
        savedStart := first+(choose1 ? a1 : a2)
        savedLast := last
        savedLowTouches := choose1 ? lc1 : lc2
        savedHighTouches := choose1 ? hc1 : hc2
        [zone,rs,re,rl,rh] = initialZone(lows,highs,closes,choose1 ? a1 : a2,savedSlope,savedLower,savedUpper,n,offset)
        savedZone := zone
        savedRangeStart := na(rs) ? na : first+rs
        savedRangeEnd := na(re) ? na : first+re
        savedRangeLow := rl
        savedRangeHigh := rh
        brokenAt := na
        brokenDirection := ""
    if barstate.islast
        bool active = v1 or v2
        bool retained = not na(savedLast) and last-savedLast <= 200
        if (active or retained) and (not showPoc or na(vpPoc))
            int endBar = active ? last : (na(brokenAt) ? savedLast : brokenAt)
            color channelColor = active ? color.orange : color.gray
            for band = -1 to 1
                float edge = (savedLower+savedUpper)/2+band*(savedUpper-savedLower)/2
                array.push(drawings,line.new(savedStart,edge+savedSlope*(savedStart-savedFirst),endBar,edge+savedSlope*(endBar-savedFirst),color=channelColor,style=active ? line.style_dashed : line.style_dotted,width=band==0 ? 1 : 2))
            string touches = str.tostring(savedLowTouches)+" low / "+str.tostring(savedHighTouches)+" high touches"
            string confirmation = savedLowTouches<2 or savedHighTouches<2 ? " · provisional" : " · confirmed"
            string status = active ? "Swing · "+touches+confirmation : "תעלה קודמת · "+(na(brokenAt) ? "לא תקפה כעת" : brokenDirection)+" · "+touches+confirmation+" · לא איתות בוט"
            array.push(captions,label.new(endBar,savedLower+savedSlope*(endBar-savedFirst),status,style=label.style_label_left,color=color.new(channelColor,65),textcolor=color.white,tooltip="Gray dotted lines preserve previous geometry. Break direction uses a closed candle beyond the boundary tolerance. A new valid channel replaces this snapshot. History retention: up to 200 bars."))
        else if not showPoc or na(vpPoc)
            string missing = geometryFound ? "Swing · waiting for two touches on each boundary" : "Swing · no valid pivot channel in " + str.tostring(n) + " closed bars"
            array.push(captions,label.new(last,low[offset],missing,style=label.style_label_left,color=color.new(color.orange,65),textcolor=color.white,tooltip="Strict pivots must exceed the two bars on each side. Equal highs/lows do not qualify. A candidate also needs valid width and closes inside its boundaries."))

// Same bounded SMA-seeded EMA50 calculation as the app; only completed 1h bars.
f_hourDirection() =>
    int count = math.min(100, bar_index + 1)
    float average = na
    float previous = na
    if count >= 51
        average := 0.0
        for i = count - 1 to count - 50
            average += close[i] / 50
        for i = count - 51 to 0
            previous := average
            average += (close[i] - average) * 2 / 51
    [average[1], previous[1], close[1]]
string trendTicker = syminfo.type == "stock" or syminfo.type == "fund" ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
[hourEma, hourPreviousEma, hourClose] = request.security(trendTicker, "60", f_hourDirection(), lookahead=barmerge.lookahead_on)
bool showHourEma = input.bool(true, "Show closed-hour EMA50", group="Entry confirmation")
plot(showHourEma ? hourEma : na, "Closed-hour EMA50", color=color.fuchsia, linewidth=2)

// One combined indicator keeps the regression optional and the frozen POC visible.
// This 128-bin OHLC range-weighted estimate is approximate; it is not trade-by-trade POC.
if barstate.islast
    for item in vpBoxes
        box.delete(item)
    array.clear(vpBoxes)
    for item in vpLines
        line.delete(item)
    array.clear(vpLines)
    for item in vpLabels
        label.delete(item)
    array.clear(vpLabels)
    table.clear(pocTable,0,0,0,5)
    if timeframe.in_seconds() != 300
        table.cell(pocTable,0,0,"Select 5-minute candles for LEVI entry geometry",text_color=color.orange)
    else if showPoc and not na(vpPoc) and not na(vpB)
        float step = (vpHigh-vpLow)/128
        float largest = array.max(vpVolumes)
        int histogramLeft = math.max(vpA,bar_index-80)
        for bin = 0 to 127
            float v = array.get(vpVolumes,bin)
            if v > 0
                int right = histogramLeft+math.max(1,int(math.round(math.min(10,math.max(1,vpB-vpA))*v/largest)))
                color c = bin == array.indexof(vpVolumes,largest) ? color.yellow : color.new(color.aqua,65)
                array.push(vpBoxes,box.new(histogramLeft,vpLow+(bin+1)*step,right,vpLow+bin*step,border_color=color.new(c,100),bgcolor=c))
        array.push(vpLines,line.new(vpB,vpPoc,bar_index+2,vpPoc,color=color.yellow,width=2,style=line.style_dashed))
        for band = 0 to 1
            float edge = band == 0 ? vpLower : vpUpper
            array.push(vpLines,line.new(vpChannelStart,edge+vpSlope*(vpChannelStart-vpFirst),bar_index,edge+vpSlope*(bar_index-vpFirst),color=color.orange,width=2))
        array.push(vpLabels,label.new(vpA,vpPriceA,"A",style=vpSide == 1 ? label.style_label_up : label.style_label_down,color=color.new(color.blue,50),textcolor=color.white))
        array.push(vpLabels,label.new(vpB,vpPriceB,"B",style=vpSide == 1 ? label.style_label_down : label.style_label_up,color=color.new(color.blue,50),textcolor=color.white))
        array.push(vpLabels,label.new(bar_index+2,vpPoc,"POC estimate · 128 bins "+str.tostring(vpPoc,format.mintick),style=label.style_label_left,color=color.new(color.yellow,65),textcolor=color.white))
        bool rangeOK = vpZone == 2 or (vpSide == 1 ? vpZone == 1 : vpZone == 3)
        // The current 5m bar cannot confirm its own reclaim.
        bool touched = false
        int confirmedBar = na
        if bar_index - vpB > 1
            for k = math.min(200, bar_index-vpB-1) to 1
                if vpSide == 1 ? low[k] <= vpPoc : high[k] >= vpPoc
                    touched := true
                if touched and (vpSide == 1 ? close[k] > vpPoc : close[k] < vpPoc)
                    confirmedBar := bar_index-k
                    touched := false
        bool returned = confirmedBar == bar_index-1 and (vpSide == 1 ? close > vpPoc and high <= vpPriceB : close < vpPoc and low >= vpPriceB)
        bool trendOK = not na(hourPreviousEma) and (vpSide == 1 ? hourEma > hourPreviousEma and hourClose > hourEma and close > hourEma : hourEma < hourPreviousEma and hourClose < hourEma and close < hourEma)
        table.cell(pocTable,0,0,(vpSide==1 ? "LONG" : "SHORT")+" SETUP · not an open position",text_color=color.yellow)
        table.cell(pocTable,0,1,"1 ✓ Confirmed channel · 3 ✓ Breakout",text_color=color.white)
        table.cell(pocTable,0,2,rangeOK ? "8 ✓ Initial consolidation" : "8 ○ Initial consolidation does not match",text_color=rangeOK ? color.lime : color.orange)
        table.cell(pocTable,0,3,returned ? "4 ✓ Closed 5m POC reclaim" : "4 ○ Waiting for closed 5m POC reclaim",text_color=returned ? color.lime : color.orange)
        table.cell(pocTable,0,4,trendOK ? "✓ Closed-hour EMA50 direction" : "○ Hourly direction not confirmed",text_color=trendOK ? color.lime : color.orange)
        table.cell(pocTable,0,5,"Chart data only · not broker execution approval",text_color=color.silver,text_size=size.small)
    else if showPoc
        table.cell(pocTable,0,0,"Waiting for confirmed channel and breakout to fix A–B",text_color=color.orange)

// Broker exit thresholds are imported explicitly. Pine does not read the bot account.
// No trading logic, reconstructed peak, alerts or assumed fills are used here.
string exitSnapshot = input.text_area("", "Bot exit snapshot", group="Bot exit levels", tooltip="Copy from LEVI app. One-time price snapshot; not a live connection. Refresh after two minutes or any position/settings change.")
bool showExitTarget = input.bool(true, "Show Take Profit line", group="Bot exit levels", tooltip="A distant target can compress the chart. Its value is always shown in the table.")
bool showExitActivation = input.bool(false, "Show profit activation line", group="Bot exit levels")
var array<line> exitLines = array.new<line>()
var array<label> exitLabels = array.new<label>()
var table exitTable = table.new(position.bottom_left, 1, 6, bgcolor=color.new(color.black, 15))

if barstate.islast
    for item in exitLines
        line.delete(item)
    array.clear(exitLines)
    for item in exitLabels
        label.delete(item)
    array.clear(exitLabels)
    table.clear(exitTable, 0, 0, 0, 5)
    string raw = str.trim(exitSnapshot)
    if str.length(raw) > 0
        array<string> fields = str.split(raw, "|")
        bool valid = (array.size(fields) == 10 or array.size(fields) == 15 or array.size(fields) == 16) and str.length(raw) <= 800
        string status = "Invalid bot snapshot - copy again from LEVI"
        if valid
            string version = array.get(fields, 0)
            string symbol = array.get(fields, 1)
            float atValue = str.tonumber(array.get(fields, 2))
            float entryAtValue = str.tonumber(array.get(fields, 3))
            float entryValue = str.tonumber(array.get(fields, 4))
            float stopValue = str.tonumber(array.get(fields, 5))
            float targetValue = str.tonumber(array.get(fields, 6))
            float activationValue = str.tonumber(array.get(fields, 7))
            float armedValue = str.tonumber(array.get(fields, 8))
            float brokerStopValue = str.tonumber(array.get(fields, 9))
            bool v3 = version == "LEVI_EXIT_V3" and array.size(fields) == 16
            bool v2 = (version == "LEVI_EXIT_V2" and array.size(fields) == 15) or v3
            string side = v2 ? array.get(fields, 10) : "LONG"
            float direction = side == "SHORT" ? -1 : 1
            float stopPct = v2 ? str.tonumber(array.get(fields, 11)) : na
            float targetPct = v2 ? str.tonumber(array.get(fields, 12)) : na
            float activationPct = v2 ? str.tonumber(array.get(fields, 13)) : na
            float gapPp = v2 ? str.tonumber(array.get(fields, 14)) : na
            valid := ((version == "LEVI_EXIT_V1" and array.size(fields) == 10) or v2) and (side == "LONG" or side == "SHORT") and not na(atValue) and not na(entryAtValue) and not na(entryValue) and not na(stopValue) and not na(targetValue) and not na(activationValue) and not na(armedValue) and not na(brokerStopValue)
            valid := valid and atValue > 0 and entryAtValue > 0 and entryAtValue <= atValue and entryValue > 0 and stopValue > 0 and direction*(targetValue-entryValue) > 0 and activationValue >= 0 and brokerStopValue >= 0 and (armedValue == 0 or armedValue == 1)
            valid := valid and (not v2 or (not na(stopPct) and not na(targetPct) and not na(activationPct) and not na(gapPp) and stopPct >= -1 and targetPct >= -1 and activationPct >= -1 and gapPp >= -1))
            bool usStock = symbol == "US:" + syminfo.ticker and syminfo.currency == "USD" and (syminfo.type == "stock" or syminfo.type == "fund") and (syminfo.prefix == "NASDAQ" or syminfo.prefix == "NYSE" or syminfo.prefix == "AMEX" or syminfo.prefix == "NYSEARCA")
            if valid
                if symbol != syminfo.prefix + ":" + syminfo.ticker and not usStock
                    valid := false
                    status := "Snapshot is for " + symbol + " - select that symbol or copy again"
                else if atValue > timenow or timenow - atValue > 120000
                    valid := false
                    status := "Snapshot expired - refresh in LEVI and copy again"
            if valid
                int at = int(atValue)
                string stamp = str.format_time(at, "HH:mm:ss", "Asia/Jerusalem")
                array.push(exitLines, line.new(int(entryAtValue), entryValue, at + 60000, entryValue, xloc=xloc.bar_time, extend=extend.right, color=color.silver, style=line.style_dotted))
                array.push(exitLabels, label.new(int(entryAtValue), entryValue, side + " entry " + str.tostring(entryValue, format.mintick), xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.gray, 35), textcolor=color.white, size=size.small))
                array.push(exitLines, line.new(at, stopValue, at + 60000, stopValue, xloc=xloc.bar_time, extend=extend.right, color=color.red, style=line.style_dashed, width=2))
                array.push(exitLabels, label.new(at, stopValue, (side == "SHORT" ? "Upper barrier · stop " : "Lower barrier · stop ") + str.tostring(stopValue, format.mintick) + " · snapshot " + stamp, xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.red, 25), textcolor=color.white, size=size.small))
                if showExitTarget
                    array.push(exitLines, line.new(at, targetValue, at + 60000, targetValue, xloc=xloc.bar_time, extend=extend.right, color=color.lime, style=line.style_dotted))
                    array.push(exitLabels, label.new(at, targetValue, (side == "SHORT" ? "Lower barrier · TP " : "Upper barrier · TP ") + str.tostring(targetValue, format.mintick), xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.green, 25), textcolor=color.white, size=size.small))
                if showExitActivation and activationValue > 0
                    array.push(exitLines, line.new(at, activationValue, at + 60000, activationValue, xloc=xloc.bar_time, extend=extend.right, color=color.yellow, style=line.style_dotted))
                    array.push(exitLabels, label.new(at, activationValue, "Protection activation (not a sale) " + str.tostring(activationValue, format.mintick), xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.orange, 25), textcolor=color.white, size=size.small))
                table.cell(exitTable, 0, 0, side + " POSITION · BOT SNAPSHOT · " + stamp + " Israel · NOT LIVE", text_color=color.orange, text_size=size.small)
                table.cell(exitTable, 0, 1, "Stop " + str.tostring(stopValue, format.mintick) + " · TP " + str.tostring(targetValue, format.mintick), text_color=color.white, text_size=size.small)
                table.cell(exitTable, 0, 2, activationValue > 0 ? "Activation " + str.tostring(activationValue, format.mintick) + (armedValue == 1 ? " · armed" : " · waiting") : "Fixed exit policy", text_color=color.white, text_size=size.small)
                table.cell(exitTable, 0, 4, "Entry " + str.tostring(entryValue, format.mintick) + " · stop P/L " + str.tostring(direction*(stopValue/entryValue-1)*100,"#.##") + "% · target " + str.tostring(direction*(targetValue/entryValue-1)*100,"#.##") + "%", text_color=color.white, text_size=size.small)
                if v2
                    table.cell(exitTable, 0, 5, "Settings: SL " + (stopPct < 0 ? "unknown" : str.tostring(stopPct,"#.##")) + "% · TP " + (targetPct < 0 ? "unknown" : str.tostring(targetPct,"#.##")) + "% · activation " + (activationPct < 0 ? "unknown" : str.tostring(activationPct,"#.##")) + "% · trail gap " + (gapPp < 0 ? "unknown" : str.tostring(gapPp,"#.##")) + (v3 ? "% of peak/trough (5 waves)" : " pp"), text_color=color.aqua, text_size=size.small)
                table.cell(exitTable, 0, 3, brokerStopValue > 0 ? "Exchange stop at snapshot: " + str.tostring(brokerStopValue, format.mintick) : "Exchange stop not verified", text_color=brokerStopValue > 0 ? color.silver : color.orange, text_size=size.small)
        if not valid
            table.cell(exitTable, 0, 0, status, text_color=color.orange, text_size=size.small)
