//@version=6
indicator("LEVI · MA 20/50/100/200 + RSI", overlay=false)
show20 = input.bool(true, "MA 20", group="Moving averages")
show50 = input.bool(true, "MA 50", group="Moving averages")
show100 = input.bool(true, "MA 100", group="Moving averages")
show200 = input.bool(true, "MA 200", group="Moving averages")
showRsi = input.bool(true, "RSI (14)", group="RSI")
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
ma100 = ta.sma(close, 100)
ma200 = ta.sma(close, 200)
rsi = ta.rsi(close, 14)
plot(show20 ? ma20 : na, "MA 20", color=#ffc857, linewidth=2, force_overlay=true)
plot(show50 ? ma50 : na, "MA 50", color=#48d597, linewidth=2, force_overlay=true)
plot(show100 ? ma100 : na, "MA 100", color=#ed86d1, linewidth=2, force_overlay=true)
plot(show200 ? ma200 : na, "MA 200", color=#397dff, linewidth=2, force_overlay=true)
plot(showRsi ? rsi : na, "RSI (14)", color=#bb90ff, linewidth=2)
hline(showRsi ? 70 : na, "70", color=color.gray)
hline(showRsi ? 50 : na, "50", color=color.gray)
hline(showRsi ? 30 : na, "30", color=color.gray)
// Display only; uses the chart timeframe. Hiding RSI leaves its empty pane.
